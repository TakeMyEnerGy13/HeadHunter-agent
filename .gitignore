# Файл .gitignore

# Секреты
.env
*.session
*.session-journal

# Локальная база бота
*.sqlite
*.sqlite3

# Личное резюме — персональные данные, репозиторий публичный
docs/resume.md

# Локальные отчёты eval runs
evals/results/

# Виртуальное окружение
venv/
env/
.venv/

# Кэш Python
__pycache__/
*.py[cod]
*$py.class

# IDE настройки (Cursor/VSCode)
.vscode/

# Исключаем файлы Excel, чтобы не пушить спам
*.xlsx

# Деплой-артефакты (могут содержать .env и базы)
*.tar.gz
