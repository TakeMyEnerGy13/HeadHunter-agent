# Файл .env.example (Шаблон. Переименуйте в .env и вставьте свои данные)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=http://localhost:20128/v1
MODEL_NAME=kr/claude-sonnet-4.5
HH_USER_AGENT=hh-agent/0.2 (+https://github.com/TakeMyEnerGy13/HeadHunter-agent)
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here
BOT_DB_PATH=bot_data.sqlite
TRACE_DB_PATH=data/traces.sqlite

# Telegram user client for reading public job channels via Telethon
TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_NAME=job_bot_tg_source
TG_JOB_CHANNELS=ods_jobs,some_ai_jobs_channel
TG_SOURCE_KEYWORDS=python,ai,llm,qa automation
TG_SOURCE_NEGATIVE_KEYWORDS=senior,lead,relocation only
TG_SOURCE_DB_PATH=data/source_posts.sqlite

# --- Job Sources ---
# SuperJob: register at https://api.superjob.ru/register to get a key
SUPERJOB_API_KEY=
# Trudvsem (Работа России): free, no key needed. Set to 0 to disable
TRUDVSEM_ENABLED=1
